<UserControl x:Class="DesktopGroups.ColorPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <StackPanel Width="300">
        <!-- Left to right is hue, top to bottom is lightness. The palette stays LTR so the marker matches the mouse position. -->
        <Border Width="300" Height="200" CornerRadius="8" ClipToBounds="True" FlowDirection="LeftToRight">
            <Canvas x:Name="PaletteCanvas" Width="300" Height="200" Background="Transparent" Cursor="Cross"
                    MouseLeftButtonDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove"
                    MouseLeftButtonUp="OnCanvasMouseUp">
                <Image x:Name="PaletteImage" Width="300" Height="200" />
                <Ellipse x:Name="Marker" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                         IsHitTestVisible="False" />
            </Canvas>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Ellipse x:Name="Preview" Width="28" Height="28" StrokeThickness="1"
                     Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <TextBlock x:Name="HexText" Margin="12,0,0,0" VerticalAlignment="Center"
                       FontFamily="Consolas" FontSize="14" />
        </StackPanel>
    </StackPanel>
</UserControl>
