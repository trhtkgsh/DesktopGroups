<UserControl x:Class="DesktopGroups.ValueSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LabelText" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <!-- Typed values are applied on Enter or when the box loses focus, and clamped to the range. -->
            <ui:TextBox x:Name="ValueBox" Grid.Column="1" Width="78" FontSize="13" TextAlignment="Center"
                        KeyDown="ValueBox_KeyDown" LostFocus="ValueBox_LostFocus" />
        </Grid>
        <Slider x:Name="SliderControl" FlowDirection="LeftToRight"
                Minimum="{Binding Minimum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Maximum="{Binding Maximum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Value="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                ValueChanged="SliderControl_ValueChanged" />
    </StackPanel>
</UserControl>
