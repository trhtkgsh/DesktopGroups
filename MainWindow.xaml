<ui:FluentWindow x:Class="DesktopGroups.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:DesktopGroups"
                 Title="מרחב הקיצורים - ניהול"
                 Width="1500" Height="1000" MinWidth="960" MinHeight="680"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 FlowDirection="RightToLeft">
    <Window.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush" />

        <!-- Circle that shows a color and opens the palette dropdown when clicked. -->
        <Style x:Key="ColorDotButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="בחר צבע" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Width="26" Height="26" StrokeThickness="2"
                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                 Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HexToBrush}}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon-only button; the Tag holds the hover color, shown only while the mouse is over it. -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Icon font and colors are set on the presenter, not the Button, so tooltips keep the normal font. -->
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="Segoe MDL2 Assets" TextElement.FontSize="14"
                                              TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HexToBrush}}" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Presenter" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Palette dropdown: a popup that hosts the color panel, closed by clicking outside it. -->
        <Style x:Key="PaletteBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="מרחב הקיצורים - ניהול" />

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <!-- Right to left: settings, then group list, then group editor. -->
                <ColumnDefinition Width="290" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Settings -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="מיקום על המסך" />
                            <TextBlock Text="מיקום צד במסך" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox SelectedValue="{Binding Board.ScreenEdge, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,8">
                                <ComboBoxItem Content="חופשי" Tag="{x:Static local:ScreenEdge.Free}" />
                                <ComboBoxItem Content="צד שמאל" Tag="{x:Static local:ScreenEdge.Left}" />
                                <ComboBoxItem Content="צד ימין" Tag="{x:Static local:ScreenEdge.Right}" />
                                <ComboBoxItem Content="למעלה" Tag="{x:Static local:ScreenEdge.Top}" />
                                <ComboBoxItem Content="למטה" Tag="{x:Static local:ScreenEdge.Bottom}" />
                            </ComboBox>
                            <local:ValueSlider Label="אופקי (שמאל ← ימין) %" Minimum="0" Maximum="100"
                                               IsEnabled="{Binding Board.CanMoveHorizontally}"
                                               Value="{Binding Board.HorizontalPosition, Mode=TwoWay}" />
                            <local:ValueSlider Label="אנכי (למעלה ↑ למטה) %" Minimum="0" Maximum="100"
                                               IsEnabled="{Binding Board.CanMoveVertically}"
                                               Value="{Binding Board.VerticalPosition, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="מראה" />
                            <TextBlock Text="תצוגת קבוצות" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox SelectedValue="{Binding Board.GroupLayout, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,8">
                                <ComboBoxItem Content="מאוזן (כל הגבהים שווים)" Tag="{x:Static local:GroupLayout.Horizontal}" />
                                <ComboBoxItem Content="אנכי (כל הרוחבים שווים)" Tag="{x:Static local:GroupLayout.Vertical}" />
                            </ComboBox>
                            <TextBlock Text="תצוגת פריטים" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox SelectedValue="{Binding Board.ItemDisplayMode, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,8">
                                <ComboBoxItem Content="שורה (סמל וכיתוב בצד)" Tag="{x:Static local:ItemDisplayMode.Row}" />
                                <ComboBoxItem Content="סמל עם כיתוב למטה" Tag="{x:Static local:ItemDisplayMode.IconWithCaption}" />
                            </ComboBox>
                            <local:ValueSlider Label="גודל אייקונים %" Minimum="50" Maximum="500"
                                               Value="{Binding Board.DisplayScale, Mode=TwoWay}" />
                            <local:ValueSlider Label="גודל טקסט %" Minimum="50" Maximum="200"
                                               Value="{Binding Board.TextScale, Mode=TwoWay}" />
                            <local:ValueSlider Label="גודל אייקוני כיבוי %" Minimum="50" Maximum="300"
                                               Value="{Binding Board.PowerIconScale, Mode=TwoWay}" />
                            <local:ValueSlider Label="שקיפות כל הקבוצות %" Minimum="20" Maximum="100"
                                               Value="{Binding Board.GroupOpacity, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="ניהול" />
                            <ui:Button Content="{Binding WidgetButtonText}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                       Command="{Binding ToggleWidgetCommand}" />
                            <ui:ToggleSwitch Content="הפעל את הקבוצות עם Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,8" />
                            <ui:Button Content="סגור את התוכנה" Appearance="Danger" HorizontalAlignment="Stretch"
                                       Command="{Binding CloseAppCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Group list, with the add-group controls above it -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="קבוצות" />

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox PlaceholderText="שם קבוצה חדשה"
                                    Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="NewGroupColorButton" Grid.Column="1" Margin="8,0,0,0"
                                Style="{StaticResource ColorDotButtonStyle}"
                                Tag="{Binding NewGroupColor}" Click="NewGroupColorButton_Click" />
                        <Popup x:Name="NewGroupPalette" PlacementTarget="{Binding ElementName=NewGroupColorButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               Closed="Palette_Closed">
                            <Border Style="{StaticResource PaletteBorderStyle}">
                                <local:ColorPickerPanel x:Name="NewGroupPicker" />
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="הוסף קבוצה" Appearance="Primary" HorizontalAlignment="Stretch"
                                   Margin="0,0,6,0" Command="{Binding AddGroupCommand}" />
                        <ui:Button Grid.Column="1" Content="▲" Margin="0,0,6,0" ToolTip="הזז קבוצה למעלה"
                                   Command="{Binding MoveGroupUpCommand}" />
                        <ui:Button Grid.Column="2" Content="▼" ToolTip="הזז קבוצה למטה"
                                   Command="{Binding MoveGroupDownCommand}" />
                    </Grid>

                    <ListBox Grid.Row="3" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Margin="0,0,8,0" Fill="{Binding AccentBrush}" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Group editor for the selected group -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGroup}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="עריכת קבוצה" />

                    <!-- Name, color and group buttons on one row -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="90" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox PlaceholderText="שם הקבוצה"
                                    Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="GroupColorButton" Grid.Column="1" Margin="8,0,8,0"
                                Style="{StaticResource ColorDotButtonStyle}"
                                Tag="{Binding SelectedGroup.Color}" Click="GroupColorButton_Click" />
                        <Popup x:Name="GroupPalette" PlacementTarget="{Binding ElementName=GroupColorButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               Closed="Palette_Closed">
                            <Border Style="{StaticResource PaletteBorderStyle}">
                                <local:ColorPickerPanel x:Name="GroupPicker" />
                            </Border>
                        </Popup>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="הוסף קבצים" Tag="#FF0078D4" Grid.Column="2"
                                Command="{Binding AddFilesCommand}">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="הוסף תיקיות" Tag="#FFFFB900" Grid.Column="3"
                                Command="{Binding AddFoldersCommand}">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="מחק קבוצה" Tag="#FFD13438" Grid.Column="4"
                                Margin="0" Command="{Binding RemoveGroupCommand}">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource AddIconButtonStyle}" ToolTip="הוסף מחשב" Tag="#FF0078D4"
                                Command="{Binding AddThisPcCommand}">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                        <Button Style="{StaticResource AddIconButtonStyle}" ToolTip="הוסף סל מחזור" Tag="#FF107C10"
                                Command="{Binding AddRecycleBinCommand}">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                        <Button Style="{StaticResource AddIconButtonStyle}" ToolTip="הוסף קבוצת כיבוי" Tag="#FFD13438"
                                Command="{Binding AddPowerSubmenuCommand}">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                    </StackPanel>

                    <ListBox Grid.Row="3" ItemsSource="{Binding SelectedGroup.Items}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button ToolTip="החלף סמל" Tag="#FF8764B8" Margin="0,0,12,0"
                                            Command="{Binding DataContext.ChangeIconCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecycleBin}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Image Width="32" Height="32" Source="{Binding Icon}" />
                                    </Button>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecycleBin}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="בחירת סמל לסל ריק" Tag="#FF107C10"
                                                    Command="{Binding DataContext.ChooseEmptyBinIconCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}">
                                            <Image Width="20" Height="20" Source="{Binding EmptyBinPreview}" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="בחירת סמל לסל מלא" Tag="#FF107C10"
                                                    Command="{Binding DataContext.ChooseFullBinIconCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}">
                                            <Image Width="20" Height="20" Source="{Binding FullBinPreview}" />
                                        </Button>
                                    </StackPanel>


                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding TargetPath}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="הזז למעלה" Tag="#FF008272"
                                                Command="{Binding DataContext.MoveItemUpCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="הזז למטה" Tag="#FF008272"
                                                Command="{Binding DataContext.MoveItemDownCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" />
                                        </Button>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecycleBin}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                        </StackPanel>
                                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="הסר" Tag="#FFD13438"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
